# Copy to `.env` and fill in real values.
# PythonAnywhere: set these via the "Environment variables" tab of your web app,
# or place a `.env` file in the project root (never commit it).

# Production: generate with `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`
DJANGO_SECRET_KEY=change-me

# Set DJANGO_DEBUG=0 in production
DJANGO_DEBUG=0

# Comma-separated hostnames, e.g. yourusername.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com

# Comma-separated full origins allowed for CSRF (HTTPS), e.g.
# https://yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# 1 to send secure cookies (recommended on PythonAnywhere HTTPS)
DJANGO_SECURE_COOKIES=1

# Optional overrides
# DJANGO_DB_PATH=/home/yourusername/JobRec/db.sqlite3
# DJANGO_STATIC_ROOT=/home/yourusername/JobRec/static
# DJANGO_MEDIA_ROOT=/home/yourusername/JobRec/media

# OCR provider:
#   auto   — try the PaddleOCR microservice, fall back to in-process RapidOCR, then mock
#   paddle — use the PaddleOCR FastAPI microservice only (better hosts / local docker-compose)
#   rapid  — in-process RapidOCR (onnxruntime); REQUIRED on the PythonAnywhere free tier
#   mock   — graceful no-crash fallback returning empty results
OCR_PROVIDER=auto
# OCR_SERVICE_URL is the PaddleOCR microservice URL, e.g. http://127.0.0.1:8000
# OCR_SERVICE_URL=http://localhost:8001
