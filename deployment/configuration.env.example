# Copy to configuration.env and keep the completed file private.
# For the existing shared database, set its real connection URL here.
# Leaving these blank creates separate EMPTY local SQLite databases; it does NOT copy your existing records.
FLOWLAB_DATABASE_URL=
EI_LAB_DATABASE_URL=
DATABASE_URL=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_COOKIES=0
# Keep the existing data folder beside the executable, preserving its subfolders.
